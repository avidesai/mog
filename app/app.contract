// Every string is t() over strings/en.json, which scripts/sync-app.mjs generates from core/copy/strings.json.
// The look is ui.contract's parts over app.tamber's tokens, after design/screens-gamified.
use Primary, Secondary, Quiet, Option, PlanOption, Label, Chip, Gate, Mark, StreakPill, Chevron, Lock, Check, Pips, Track, Ring, NavBar, StepBar, Tile, FaceArt, Display, T1, T2, T3, RowTitle, Body, Detail, Caption, LabelText, Value, CardBox, LipBox, RaisedBox, WashBox from "./ui.contract"
use getDetails, listPurchases, unfinishedPurchases, purchase, restorePurchases, purchasesStatus, ItemDetails, PurchaseDetails, PurchasesStatus from "@exact/purchases"

routes nav
  tab today "/"
    goals "/start/goals"
    about "/start/about"
    time "/start/time"
    consent "/start/consent"
    capture "/capture"
    reveal "/reveal"
    task "/task/:id"
    done "/done"
    plan "/plan"
    card "/plan/:id"
    paywall "/pro"
  tab path "/path"
    progress "/path/progress"
  tab metrics "/metrics"
    metric "/metric/:id"
  tab you "/you"
    methodology "/you/methodology"

shape Time
  epochAtZero: number
  utcOffset: number

shape Metric
  id: string
  name: string
  short: string
  group: string
  value: string
  category: string
  suppressed: string
  evidence: string
  reliability: string
  free: bool
  plain: string
  refLow: string
  refHigh: string
  contradicted: bool
  community: bool
  pos: number

shape Card
  ruleId: string
  headline: string
  body: string
  whyThis: string
  evidence: string
  effort: string
  weeksLow: number
  weeksHigh: number
  professional: bool

shape Task
  id: string
  title: string
  cadence: string
  done: bool
  weeklyDone: number
  weeklyTarget: number
  headline: string
  body: string
  whyThis: string
  evidence: string
  effort: string
  weeksLow: number
  weeksHigh: number
  basedOn: string

shape Summary
  day: number
  week: number
  currentDays: number
  longestDays: number
  thisWeekDays: number
  banked: number[]
  scanWindow: number
  daysUntilScan: number
  repairAvailable: bool
  atRisk: bool
  dayComplete: bool
  finished: bool
  distress: bool
  opensToday: number

shape ProgressRow
  id: string
  short: string
  locked: bool
  delta: string
  before: string
  after: string
  withinNoise: bool
  better: bool
  posA: number
  posB: number

shape Progress
  comparable: bool
  delta: string
  up: bool
  withinNoise: bool
  before: string
  after: string
  days: number
  weeks: number
  sinceDate: string
  lead: string
  rows: ProgressRow[]

shape AppView
  hasScan: bool
  scanDate: string
  nMetrics: number
  nLocked: number
  lockedMore: number
  lockedNames: string
  nMovable: number
  score: string
  low: string
  high: string
  lowN: number
  highN: number
  pct: string
  tier: string
  modelVersion: string
  strength: string
  improvable: string
  metrics: Metric[]
  plan: Card[]
  professional: Card[]
  info: Card[]
  dailyMinutes: number
  tasks: Task[]
  summary: Summary
  nScans: number
  progress: Progress

shape Reply
  ok: bool
  error: string

shape TaskReply
  ok: bool
  error: string
  dayCompleted: bool

fn tabTitle(name: string): string = name == "today" ? t("today.title") : name == "path" ? t("journey.tab") : name == "metrics" ? t("results.title") : t("settings.title")
fn goalLabel(g: string): string = g == "sharper_jawline" ? t("onboarding.goal_sharper_jawline") : g == "better_skin" ? t("onboarding.goal_better_skin") : g == "look_leaner" ? t("onboarding.goal_look_leaner") : g == "hair" ? t("onboarding.goal_hair") : g == "eye_area" ? t("onboarding.goal_eye_area") : g == "better_photos" ? t("onboarding.goal_better_photos") : t("onboarding.goal_general")
fn ageLabel(a: string): string = a == "18-24" ? t("onboarding.about_age_18_24") : a == "25-34" ? t("onboarding.about_age_25_34") : a == "35-44" ? t("onboarding.about_age_35_44") : t("onboarding.about_age_45")
fn timeLabel(m: number): string = m == 5 ? t("onboarding.time_5") : m == 15 ? t("onboarding.time_15") : t("onboarding.time_30")
fn timeDetail(m: number): string = m == 5 ? t("onboarding.time_5_detail") : m == 15 ? t("onboarding.time_15_detail") : t("onboarding.time_30_detail")
fn evidenceLabel(g: string): string = g == "strong" ? t("common.evidence_strong") : g == "moderate" ? t("common.evidence_moderate") : g == "weak" ? t("common.evidence_weak") : g == "community" ? t("common.evidence_community") : t("common.evidence_contradicted")
fn categoryLabel(c: string): string = c == "low" ? t("common.category_low") : c == "high" ? t("common.category_high") : t("common.category_typical")
fn groupLabel(g: string): string = g == "eyes" ? t("results.group_eyes") : g == "midface" ? t("results.group_midface") : g == "lower" ? t("results.group_lower") : g == "profile" ? t("results.group_profile") : g == "proportion" ? t("results.group_proportion") : t("results.group_appearance")
fn suppressedLabel(r: string): string = r == "low_confidence" ? t("common.suppressed_low_confidence") : r == "occluded" ? t("common.suppressed_occluded") : r == "pose_missing" ? t("common.suppressed_pose_missing") : r == "not_shipped" ? t("common.suppressed_not_shipped") : ""
fn reliabilityLabel(r: string): string = r == "A" ? t("metric_detail.reliability_A") : r == "B" ? t("metric_detail.reliability_B") : t("metric_detail.reliability_C")
fn effortLabel(e: string): string = e == "low" ? t("task_detail.effort_low") : e == "medium" ? t("task_detail.effort_medium") : t("task_detail.effort_high")
fn cadenceLabel(c: string): string = c == "daily" ? t("task_detail.cadence_daily") : c == "weekly" ? t("task_detail.cadence_weekly") : t("task_detail.cadence_once")
fn gateLabel(i: string): string = i == "0" ? t("capture.gate_angle") : i == "1" ? t("capture.gate_lighting") : i == "2" ? t("capture.gate_distance") : i == "3" ? t("capture.gate_expression") : i == "4" ? t("capture.gate_clear") : t("capture.gate_sharp")
fn hintLabel(k: string): string = k == "capture.hint_closer" ? t("capture.hint_closer") : k == "capture.hint_further" ? t("capture.hint_further") : k == "capture.hint_yaw" ? t("capture.hint_yaw") : k == "capture.hint_pitch_up" ? t("capture.hint_pitch_up") : k == "capture.hint_pitch_down" ? t("capture.hint_pitch_down") : k == "capture.hint_roll" ? t("capture.hint_roll") : k == "capture.hint_lighting_uneven" ? t("capture.hint_lighting_uneven") : k == "capture.hint_lighting_dark" ? t("capture.hint_lighting_dark") : k == "capture.hint_clipping" ? t("capture.hint_clipping") : k == "capture.hint_expression" ? t("capture.hint_expression") : k == "capture.hint_occlusion" ? t("capture.hint_occlusion") : k == "capture.hint_sharp" ? t("capture.hint_sharp") : t("capture.hint_ready")
fn stepLabel(i: number): string = i <= 0 ? t("processing.step_landmarks") : i == 1 ? t("processing.step_normalise") : i == 2 ? t("processing.step_metrics") : t("processing.step_reference")
fn priceOf(plans: ItemDetails[], id: string): string = match first(plans.filter(p => p.itemId == id)) { case some(p) => p.displayPrice, case none => id == "pro.annual" ? "$34.99" : "$4.99" }
// The billed amount as a number, for the saving and the weekly equivalent. With no store, the catalog's prices.
fn priceNum(plans: ItemDetails[], id: string): number = match first(plans.filter(p => p.itemId == id)) { case some(p) => match parseNumber(p.price.value) { case some(n) => n, case none => 0 }, case none => id == "pro.annual" ? 34.99 : 4.99 }
// The path's eight nodes on a 350 × 560 field, as the artboard places them.
fn nodeX(w: number): number = w == 1 or w == 5 ? 70 : w == 3 or w == 7 ? 280 : 180
fn nodeY(w: number): number = 34 + 64 * (w - 1) + (w == 8 ? 8 : 0)

// How the score works: ten frames settle on the median, the marker lands in the range, the score moves inside its band.
keyframes frameA
  0% cy=16
  55% cy=48
keyframes frameB
  0% cy=32
  55% cy=48
keyframes frameC
  0% cy=62
  55% cy=48
keyframes frameD
  0% cy=80
  55% cy=48
keyframes place
  from cx=40
keyframes sweep
  from translate="0% 0px"
  to translate="100% 0px"

shape Media
  prefersReducedMotion: bool

component App
  state onboarded = false persist
  state goals = [] persist
  state sex = "" persist
  state ageBand = "" persist
  state adult = false persist
  state timeBudget = 15 persist
  state region = "" persist
  state consentedOn = "" persist
  state streakSeenOn = "" persist
  state consentedAt = 0 persist
  state consentPolicy = "" persist
  state adultAt = 0 persist
  state declined = false
  state capStep = 0
  state capturing = false
  // What <mog-capture> last said: the six checks as 0/1, the hint key, a check that drifted, the readings.
  state captureMask = "000000"
  state captureHint = "capture.hint_yaw"
  state captureAbort = ""
  state captureUnsupported = false
  state captureDenied = false
  state captureFailed = false
  state captured = ""
  state now = 0
  resource time = exactTime() as shape Time
  derive today = formatDate(time.epochAtZero + now, time.utcOffset, "iso")
  state plan = "pro.annual"
  state buyNote = ""
  resource store = purchasesStatus() as shape PurchasesStatus else empty()
  // A screen gates on what the person holds; delivery reads the store's queue and nothing else.
  resource owned = listPurchases() as shape PurchaseDetails[] else empty()
  resource queue = unfinishedPurchases() as shape PurchaseDetails[] else empty()
  resource plans = getDetails(itemIds=["pro.annual", "pro.weekly"]) as shape ItemDetails[] else empty()
  mutation bought as shape PurchaseDetails refreshes queue, owned then afterBuy
  mutation restored as shape PurchaseDetails[] refreshes owned
  mutation delivered as shape Reply refreshes owned, queue
  derive yearPrice = priceNum(plans, "pro.annual")
  derive weekPrice = priceNum(plans, "pro.weekly")
  derive saving = yearPrice > 0 and yearPrice < weekPrice * 52 ? 1 - yearPrice / (weekPrice * 52) : 0
  derive inDollars = match first(plans) { case some(p) => p.price.currency == "USD", case none => true }
  derive isPro = owned.filter(p => p.itemId.startsWith("pro.")).length > 0
  derive due = queue.filter(p => p.purchaseState == "purchased").map(p => p.purchaseToken).join(",")
  derive buyError = match failure(bought) { case some(f) => f.code == "AbortError" ? "" : t("paywall.failed"), case none => "" }
  resource app = loadApp(today, isPro) as shape AppView else empty() transient
  mutation scanned as shape Reply refreshes app then afterScan
  mutation taskSet as shape TaskReply queue refreshes app then afterTask
  mutation repaired as shape Reply refreshes app
  mutation wiped as shape Reply refreshes app then afterWipe
  mutation opened as shape Reply refreshes app
  mutation checkedIn as shape Reply refreshes app
  resource media = exactViewport() as shape Media
  derive still = media.prefersReducedMotion
  // The band on a 0 to 10 track; before a scan, the example from the old copy.
  derive bandLow = app.hasScan ? app.low : "5.0"
  derive bandHigh = app.hasScan ? app.high : "7.8"
  derive bandStart = (app.hasScan ? app.lowN : 5) * 10
  derive bandWidth = ((app.hasScan ? app.highN : 7.8) - (app.hasScan ? app.lowN : 5)) * 10
  derive aboutReady = sex != "" and ageBand != "" and adult and region != ""
  // Consent is per policy version (biometric data policy §5): a new version asks again before the next capture.
  derive policyVersion = "1.0"
  derive consentCurrent = consentedOn != "" and consentPolicy == policyVersion and region != "restricted"
  derive left = app.tasks.filter(k => k.cadence == "daily" and not k.done).length
  // The drawn tab bar shows on the four tab roots only; pushed screens take the whole height.
  derive atRoot = top(nav).name == "today" or top(nav).name == "path" or top(nav).name == "metrics" or top(nav).name == "you"
  derive showTabs = onboarded and atRoot
  derive sexPlural = sex == "female" ? t("common.sex_plural_female") : t("common.sex_plural_male")
  task tick mount
    every(60000, step)
  task scanning when capturing
    every(450, advance)
  task delivering when due != "" key=due
    after(1, deliver)
  // Each time Metrics comes to the front, count it once for the check-in card.
  task countOpen when onboarded and top(nav).name == "metrics"
    after(1, noteOpen)

  action step
    now = performanceNow()
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  action visit(url: string)
    nav = push(nav, url)
  action toggleGoal(g: string)
    goals = goals.includes(g) ? goals.filter(x => x != g) : goals.length < 3 ? goals.concat([g]) : goals
  action setSex(v: string)
    sex = v
  action setAge(v: string)
    ageBand = v
  action setAdult(on: bool)
    adult = on
    adultAt = on ? time.epochAtZero + performanceNow() : 0
  action setRegion(v: string)
    region = v
  action setTime(m: number)
    timeBudget = m
  action consent
    if aboutReady and region != "restricted"
      consentedOn = today
      consentedAt = time.epochAtZero + performanceNow()
      consentPolicy = policyVersion
      declined = false
      resetCapture()
      nav = push(nav, "/capture")
  // "Not now" is a refusal: a consent given earlier does not stand behind it.
  action decline
    declined = true
    consentedOn = ""
    consentedAt = 0
    consentPolicy = ""
    resetCapture()
  action resetCapture
    capStep = 0
    capturing = false
    captureMask = "000000"
    captureHint = "capture.hint_yaw"
    captureAbort = ""
    captureUnsupported = false
    captureDenied = false
    captureFailed = false
    captured = ""
  action onCapture(msg: string)
    if msg.startsWith("gates ")
      captureMask = msg.slice(6, 12)
      captureHint = msg.slice(13)
    else if msg.startsWith("aborted ")
      captureAbort = msg.slice(8)
    else if msg == "unsupported"
      captureUnsupported = true
    else if msg == "denied"
      captureDenied = true
    else if msg == "sample" or msg.startsWith("readings ")
      captured = msg
      capStep = 0
      capturing = true
  action startScan
    if consentCurrent
      resetCapture()
      nav = push(nav, "/capture")
    else
      nav = push(nav, "/start/consent")
  // Withdrawing stops a capture in progress: the camera view unmounts and nothing is saved.
  action withdraw
    consentedOn = ""
    consentedAt = 0
    consentPolicy = ""
    resetCapture()
  action openSettings
    openURL("app-settings:")
  // The processing steps, once the readings are in; then they are scored and saved.
  // Closing the capture or withdrawing consent while it measures discards the readings.
  action advance
    if not consentCurrent or top(nav).name != "capture"
      resetCapture()
    else if capStep < 4
      capStep = capStep + 1
    else
      capturing = false
      if captured == "sample"
        send scanned = saveSampleScan(today, sex, ageBand, goals.length == 0 ? ["general"] : goals, timeBudget)
      else
        send scanned = saveScan(today, sex, ageBand, goals.length == 0 ? ["general"] : goals, timeBudget, captured.slice(9))
  action afterScan
    match scanned
      case some(r)
        if r.ok
          resetCapture()
          onboarded = true
          nav = replace(nav, "/reveal")
        else
          resetCapture()
          captureFailed = true
      case none
        resetCapture()
        captureFailed = true
  action goHome
    nav = open(nav, "/")
  action seeAll
    let home = open(nav, "/")
    nav = open(home, "/metrics")
  action setTask(id: string, done: bool)
    send taskSet = setTask(id, today, done)
  // The day's last task: mark the moment once.
  action afterTask
    match taskSet
      case some(r)
        if r.dayCompleted and top(nav).name != "done"
          nav = push(nav, "/done")
      case none
        declined = declined
  action noteOpen
    send opened = noteResultsOpen(today)
  action dismissCheckin
    send checkedIn = dismissCheckin(today)
  action aboutHelp
    openURL("https://988lifeline.org")
    send checkedIn = dismissCheckin(today)
  action seeProgress
    nav = open(nav, "/path/progress")
  action repair
    send repaired = repairStreak(today)
  action letReset
    streakSeenOn = today
  action choosePlan(id: string)
    plan = id
  action buy
    if store.available
      buyNote = ""
      send bought = purchase(itemId=plan)
    else
      buyNote = t("paywall.no_store")
  // The purchase's answer is for this screen; delivery is the queue's.
  action afterBuy
    match bought
      case some(p)
        if p.purchaseState == "pending"
          buyNote = t("paywall.pending")
        else
          nav = back(nav)
      case none
        buyNote = ""
  action restore
    send restored = restorePurchases()
  action deliver
    send delivered = deliverPurchases()
  action askWipe
    showModal("wipe")
  action wipe
    send wiped = deleteEverything()
  action afterWipe
    onboarded = false
    goals = []
    sex = ""
    ageBand = ""
    adult = false
    adultAt = 0
    timeBudget = 15
    region = ""
    consentedOn = ""
    consentedAt = 0
    consentPolicy = ""
    streakSeenOn = ""
    resetCapture()
    nav = open(nav, "/")

  view
    main navigationKey=`${top(nav).id}`
      navigationBack="back"
      navigate=follow
      testId="app"
      width="100%"
      height="100%"
      position="relative"
      background-color="bg.paper"
      color="ink.main"
      font-family="Inter Tight"
      font-variant-numeric="tabular-nums"
      column position="absolute" inset=0
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              if e.name == "today" and not onboarded
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  scroll flex=1 min-height=0
                    column padding="0 20px"
                      gap=0
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      row align-items="center" min-height=56
                        Mark(name="Mog")
                      view margin-top=24
                        FaceArt(value="", tall=true)
                      text t("onboarding.start_title") class=Display
                        role="heading"
                        aria-level=1
                        font-size="2.75rem"
                        line-height=1.3
                        margin-top=28
                        -exact-fit="shrink"
                      text t("onboarding.start_body") class=Body
                        font-size="1rem"
                        line-height="1.4375rem"
                        margin-top=14
                  column padding="12px 20px 22px"
                    gap=10
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    Primary(
                      label=t("onboarding.start_cta"),
                      go=visit("/start/goals"),
                      off=false,
                      id="start"
                    )
                    text t("onboarding.start_age_note") class=Caption text-align="center"
              else if e.name == "today"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  box-sizing="border-box"
                  padding-bottom="calc(60px + env(safe-area-inset-bottom))"
                  scroll flex=1 min-height=0 testId="today-list"
                    column padding="0 20px 24px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      row align-items="center" justify-content="space-between" min-height=56
                        Mark(name="Mog")
                        StreakPill(count=app.summary.currentDays)
                      text t("today.day_title", day=`${app.summary.day}`) class=Display
                        role="heading"
                        aria-level=1
                        font-size="3.25rem"
                        line-height=1.3
                        margin-top=6
                        -exact-fit="shrink"

                        testId="day"
                      text (left == 0 ? t("today.all_done") : left == 1 ? t("today.left_one") : t("today.left_many", n=`${left}`)) class=T3
                        color="ink.soft"
                        margin-top=10
                        testId="left"
                      row align-items="baseline"
                        justify-content="space-between"
                        margin-top=18
                        margin-bottom=8
                        gap=8
                        flex-wrap="wrap"
                        Label(label=t("today.greeting_week", week=`${app.summary.week}`))
                        text (app.summary.banked.includes(app.summary.week) ? t("today.week_banked", week=`${app.summary.week}`) : t("today.week_banking", days=`${app.summary.thisWeekDays}`)) font-size="0.75rem"
                          font-weight=600
                          color="ink.mute"
                          testId="banking"
                      Pips(days=app.summary.thisWeekDays)
                      column gap=10 margin-top=24
                        // Calm and plain on purpose (voice.md): no accent, no count-up, never an engagement surface.
                        if app.summary.distress
                          column class=CardBox padding=18 gap=10 testId="checkin"
                            text t("today.quiet_checkin_title", n=`${app.summary.opensToday}`) class=T3
                              testId="checkin-title"
                            text t("today.quiet_checkin_body") class=Body color="ink.soft"
                            row gap=10 flex-wrap="wrap" margin-top=4
                              view flex="1 1 8rem" min-width=0
                                Secondary(
                                  label=t("today.quiet_checkin_more"),
                                  go=aboutHelp,
                                  id="checkin-988"
                                )
                              view flex="1 1 8rem" min-width=0
                                Secondary(
                                  label=t("today.quiet_checkin_dismiss"),
                                  go=dismissCheckin,
                                  id="checkin-dismiss"
                                )
                        if app.summary.atRisk and streakSeenOn != today
                          column class=CardBox
                            border-color="flame.icon"
                            padding=16
                            gap=10
                            testId=(app.summary.repairAvailable ? "streak-save" : "streak-used")
                            text t("streak.save_title") class=T3
                            text (app.summary.repairAvailable ? t("streak.save_body") : t("streak.save_unavailable_body")) class=Body
                            if app.summary.repairAvailable
                              Primary(label=t("streak.save_cta"), go=repair, off=false, id="repair")
                              Quiet(label=t("streak.save_decline"), go=letReset, id="let-reset")
                              text t("streak.repair_note") class=Caption text-align="center"
                            else
                              Secondary(
                                label=t("streak.save_unavailable_cta"),
                                go=letReset,
                                id="streak-okay"
                              )
                        if app.summary.scanWindow > 0
                          column class=CardBox
                            border="2px solid"
                            border-color="accent.main"
                            border-radius=20
                            padding=18
                            gap=12
                            column gap=2
                              text t("today.scan_open_title", week=`${app.summary.scanWindow}`) class=T3
                              text t("today.scan_open_body") class=Detail
                            Primary(
                              label=t("today.scan_open_cta"),
                              go=startScan,
                              off=false,
                              id="rescan"
                            )
                        for k in app.tasks key=k.id
                          row class=(k.done ? CardBox : LipBox)
                            align-items="center"
                            gap=4
                            padding="6px 16px 6px 8px"
                            button appearance="none"
                              role="checkbox"
                              aria-checked=k.done
                              aria-label=k.title
                              press=setTask(k.id, not k.done)
                              testId=`task-${k.id}`
                              display="flex"
                              align-items="center"
                              justify-content="center"
                              width=44
                              height=44
                              flex-shrink=0
                              Check(done=k.done)
                            link href=path("task", k.id)
                              testId=`open-${k.id}`
                              display="flex"
                              align-items="center"
                              gap=12
                              flex=1
                              min-width=0
                              padding="8px 0"
                              column flex=1 min-width=0 gap=1
                                text k.title class=RowTitle
                                if k.done
                                  text t("today.task_done") class=Detail color="positive.text"
                                else if k.cadence == "weekly"
                                  text t("task_detail.weekly_progress", done=`${k.weeklyDone}`, target=`${k.weeklyTarget}`) class=Detail
                                else if k.basedOn != ""
                                  text k.basedOn class=Detail
                              Chevron()
                        link href=path("plan")
                          class=LipBox
                          testId="open-plan"
                          display="flex"
                          align-items="center"
                          gap=12
                          padding="14px 16px"
                          text t("today.plan_link") class=RowTitle flex=1
                          text (app.plan.length == 1 ? t("plan.count_one") : t("plan.count", n=`${app.plan.length}`)) class=Detail
                          Chevron()
                        if app.summary.scanWindow == 0 and app.summary.daysUntilScan > 0
                          row class=RaisedBox
                            align-items="center"
                            gap=12
                            padding="14px 16px"
                            margin-top=4
                            testId="countdown"
                            Lock()
                            column flex=1 min-width=0 gap=2
                              text (app.summary.daysUntilScan == 1 ? t("today.scan_countdown_one") : t("today.scan_countdown", days=`${app.summary.daysUntilScan}`)) font-size="0.875rem"
                                font-weight=600
                                color="ink.soft"
                              text t("today.scan_locked_why") class=Caption
              else if e.name == "goals"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  StepBar(step=1, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0
                    column padding="0 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("onboarding.goals_title") class=T1
                        role="heading"
                        aria-level=1
                        margin-top=22
                      text t("onboarding.goals_body") class=Body color="ink.mute" margin-top=8
                      column gap=9 margin-top=22
                        for g in ["sharper_jawline", "better_skin", "look_leaner", "hair", "eye_area", "better_photos", "general"] key=g
                          Option(
                            label=goalLabel(g),
                            detail="",
                            on=goals.includes(g),
                            mark=`${goals.indexOf(g) + 1}`,
                            go=toggleGoal(g),
                            id=`goal-${g}`
                          )
                  column padding="12px 20px 26px"
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    Primary(
                      label=t("common.continue"),
                      go=visit("/start/about"),
                      off=(goals.length == 0),
                      id="goals-next"
                    )
              else if e.name == "about"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  StepBar(step=2, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0
                    column padding="0 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("onboarding.about_title") class=T1
                        role="heading"
                        aria-level=1
                        margin-top=22
                      text t("onboarding.about_body") class=Body color="ink.mute" margin-top=8
                      view margin-top=24 margin-bottom=10
                        Label(label=t("onboarding.about_sex_label"))
                      row gap=10 flex-wrap="wrap"
                        for v in ["male", "female"] key=v
                          view flex="1 1 8rem" min-width=0
                            Option(
                              label=(v == "male" ? t("onboarding.about_sex_male") : t("onboarding.about_sex_female")),
                              detail="",
                              on=(sex == v),
                              mark="",
                              go=setSex(v),
                              id=`sex-${v}`
                            )
                      view margin-top=22 margin-bottom=10
                        Label(label=t("onboarding.about_age_label"))
                      row gap=10 flex-wrap="wrap"
                        for a in ["18-24", "25-34", "35-44", "45+"] key=a
                          view flex="1 1 8rem" min-width=0
                            Option(
                              label=ageLabel(a),
                              detail="",
                              on=(ageBand == a),
                              mark="",
                              go=setAge(a),
                              id=`age-${a}`
                            )
                      view margin-top=22 margin-bottom=10
                        Label(label=t("onboarding.about_state_label"))
                      column gap=9
                        for v in ["other", "restricted"] key=v
                          Option(
                            label=(v == "restricted" ? t("onboarding.about_state_restricted") : t("onboarding.about_state_other")),
                            detail="",
                            on=(region == v),
                            mark="",
                            go=setRegion(v),
                            id=`region-${v}`
                          )
                      row class=RaisedBox
                        align-items="center"
                        gap=12
                        padding="14px 16px"
                        margin-top=22
                        text t("onboarding.about_age_attest") class=RowTitle flex=1 min-width=0
                        input type="checkbox" switch
                          checked=adult
                          change=setAdult
                          aria-label=t("onboarding.about_age_attest")
                          testId="adult"
                  column padding="12px 20px 26px"
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    Primary(
                      label=t("common.continue"),
                      go=visit("/start/time"),
                      off=(not aboutReady),
                      id="about-next"
                    )
              else if e.name == "time"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  StepBar(step=3, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0
                    column padding="0 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("onboarding.time_title") class=T1
                        role="heading"
                        aria-level=1
                        margin-top=22
                      text t("onboarding.time_body") class=Body color="ink.mute" margin-top=8
                      column gap=10 margin-top=22
                        for m in [5, 15, 30] key=m
                          Option(
                            label=timeLabel(m),
                            detail=timeDetail(m),
                            on=(timeBudget == m),
                            mark="",
                            go=setTime(m),
                            id=`time-${m}`
                          )
                      column class=RaisedBox padding=16 gap=6 margin-top=22
                        Label(label=t("onboarding.time_next_label"))
                        text t("onboarding.time_next_body") class=Body
                  column padding="12px 20px 26px"
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    Primary(
                      label=t("common.continue"),
                      go=visit("/start/consent"),
                      off=false,
                      id="time-next"
                    )
              else if e.name == "consent"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(title="", trailing="", close=false, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0
                    column padding="0 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("consent.title") class=T1 role="heading" aria-level=1
                      column border="2px solid"
                        border-color="ink.main"
                        border-radius=20
                        background-color="bg.card"
                        padding=20
                        gap=16
                        margin-top=18
                        text t("consent.body_1") class=Body color="ink.main"
                        for i in [1, 2, 3, 4] key=i
                          row gap=12 align-items="flex-start"
                            svg width=20
                              height=20
                              viewBox="0 0 20 20"
                              aria-hidden=true
                              flex-shrink=0
                              margin-top=1
                              circle cx=10
                                cy=10
                                r=8.5
                                stroke="accent.main"
                                stroke-width=1.8
                                fill="none"
                              path d="M6.3 10.4l2.4 2.4 5-5.2"
                                stroke="accent.main"
                                stroke-width=1.8
                                fill="none"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            column flex=1 min-width=0 gap=2
                              text (i == 1 ? t("consent.p1_title") : i == 2 ? t("consent.p2_title") : i == 3 ? t("consent.p3_title") : t("consent.p4_title")) font-size="0.9375rem"
                                font-weight=600
                                color="ink.main"
                              text (i == 1 ? t("consent.p1_body") : i == 2 ? t("consent.p2_body") : i == 3 ? t("consent.p3_body") : t("consent.p4_body")) class=Detail
                                color="ink.soft"
                        text t("consent.point_policy") class=Detail
                      if region == "restricted"
                        column class=RaisedBox padding=16 gap=4 margin-top=16 testId="state-block"
                          text t("consent.state_block_title") class=T3
                          text t("consent.state_block_body") class=Body
                      else
                        text t("consent.affirm_label", app_name="Mog") class=Detail
                          text-align="center"
                          margin-top=16
                        if declined
                          text t("consent.decline_body") class=Detail
                            text-align="center"
                            margin-top=6
                            color="ink.main"
                            testId="declined"
                  if region != "restricted"
                    column padding="12px 20px 22px"
                      gap=4
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      Primary(label=t("consent.affirm_cta"), go=consent, off=false, id="consent")
                      Quiet(label=t("consent.decline_cta"), go=decline, id="decline")
              else if e.name == "capture"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(
                    title=t("capture.front_title"),
                    trailing="",
                    close=true,
                    back=back,
                    backLabel=t("common.close")
                  )
                  column flex=1
                    min-height=0
                    padding="0 20px 22px"
                    gap=14
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    if captured != ""
                      column flex=1
                        min-height=0
                        align-items="center"
                        justify-content="center"
                        gap=14
                        view width="100%" max-width="17rem"
                          FaceArt(value="", tall=false)
                        row width="100%"
                          max-width="17rem"
                          height=4
                          border-radius=2
                          background-color="bg.track"
                          overflow="hidden"
                          view width=`${capStep * 25}%` height=4 background-color="accent.main"
                        text t("processing.title") class=T3 testId="processing"
                        text stepLabel(capStep) class=Detail
                          text-align="center"
                          testId="processing-step"
                      row class=RaisedBox
                        align-self="center"
                        align-items="center"
                        gap=8
                        padding="8px 14px"
                        border-radius=999
                        Lock()
                        text t("processing.footnote") class=Caption
                    else if captureUnsupported or captureDenied or captureFailed
                      column flex=1 min-height=0 justify-content="center" gap=14
                        if captureFailed
                          text t("capture.aborted_title") class=T2 testId="capture-failed"
                        text (captureUnsupported ? t("capture.unsupported") : captureDenied ? t("capture.camera_denied") : t("capture.failed_body")) class=Body
                          testId=(captureUnsupported ? "capture-unsupported" : captureDenied ? "capture-denied" : "capture-failed-body")
                        if captureDenied
                          Secondary(
                            label=t("capture.open_settings"),
                            go=openSettings,
                            id="open-settings"
                          )
                        if captureFailed
                          Secondary(label=t("common.retake"), go=resetCapture, id="retake")
                    else
                      text t("capture.intro") class=Body
                      row gap=6 flex-wrap="wrap"
                        for i in [0, 1, 2, 3, 4, 5] key=i
                          Gate(label=gateLabel(`${i}`), pass=(captureMask.slice(i, i + 1) == "1"))
                      view position="relative"
                        flex=1
                        min-height=240
                        border-radius=20
                        background-color="viewport.ground"
                        overflow="hidden"
                        if consentCurrent
                          mog-capture message=onCapture
                            position="absolute"
                            inset=0
                            aria-label=t("capture.front_title")
                        svg viewBox="0 0 350 500"
                          position="absolute"
                          inset=0
                          width="100%"
                          height="100%"
                          aria-hidden=true
                          pointer-events="none"
                          ellipse cx=175
                            cy=250
                            rx=97
                            ry=130
                            fill="none"
                            stroke="viewport.guide"
                            stroke-width=1.5
                          path d="M175 132v26M175 342v26M97 250h26M227 250h26"
                            stroke="viewport.guide"
                            stroke-width=1.5
                            opacity=0.6
                        row position="absolute"
                          left=0
                          right=0
                          bottom=18
                          justify-content="center"
                          padding="0 16px"
                          row background-color="bg.card" border-radius=999 padding="9px 18px"
                            text (captureAbort != "" ? t("capture.aborted_body", gate=gateLabel(captureAbort)) : hintLabel(captureHint)) font-size="0.9375rem"
                              font-weight=600
                              color="ink.main"
                              text-align="center"
                              testId="capture-hint"
                      text t("capture.shutter_disabled_note") class=Detail text-align="center"
              else if e.name == "reveal"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  scroll flex=1 min-height=0
                    column align-items="center"
                      padding="0 20px 12px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      row align-items="center" min-height=58
                        text t("reveal.eyebrow") class=LabelText letter-spacing="0.08em"
                      Ring(low=app.lowN, high=app.highN)
                        text app.score class=Display
                          font-size=104
                          line-height=1.3
                          letter-spacing="-0.035em"
                          -exact-fit="shrink"
                          white-space="nowrap"
                          max-width="12.5rem"
                          testId="reveal-score"
                        text t("common.likely_band", low=app.low, high=app.high) font-size="0.9375rem"
                          font-weight=600
                          letter-spacing="-0.01em"
                          color="ink.soft"
                          margin-top=8
                          testId="reveal-band"
                      row class=LipBox
                        border-radius=999
                        align-items="center"
                        gap=8
                        padding="9px 18px 9px 14px"
                        margin-top=20
                        svg width=20 height=20 viewBox="0 0 22 22" aria-hidden=true
                          path d="M11 3l2.2 4.8 5.3.6-3.9 3.6 1 5.2-4.6-2.6-4.6 2.6 1-5.2L4.5 8.4l5.3-.6z"
                            fill="brand.bronze"
                        text app.tier font-size="1rem"
                          font-weight=700
                          letter-spacing="-0.014em"
                          color="ink.main"
                          testId="reveal-tier"
                        text `· ${t("common.tier_pill", pct=app.pct)}` font-size="0.875rem"
                          font-weight=500
                          color="ink.mute"
                          testId="reveal-pct"
                      row gap=10 margin-top=28 width="100%" flex-wrap="wrap"
                        Tile(
                          value=`${app.nMetrics}`,
                          label=t("reveal.measured_label"),
                          tone="plain"
                        )
                        Tile(
                          value=`${app.nMovable}`,
                          label=t("reveal.movable_label"),
                          tone="accent"
                        )
                      text t("reveal.what_it_is") class=Caption text-align="center" margin-top=24
                  column padding="8px 20px 20px"
                    gap=4
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    if app.nScans > 1
                      Primary(
                        label=t("reveal.cta_progress"),
                        go=seeProgress,
                        off=false,
                        id="see-progress"
                      )
                      Quiet(label=t("reveal.cta_today"), go=goHome, id="back-today")
                    else
                      Primary(label=t("reveal.cta_start"), go=goHome, off=false, id="start-week")
                      Quiet(label=t("reveal.cta_all", n=`${app.nMetrics}`), go=seeAll, id="see-all")
              else if e.name == "task"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(title="", trailing="", close=false, back=back, backLabel=t("common.back"))
                  for k in app.tasks.filter(x => x.id == e.params.id) key=k.id
                    scroll flex=1 min-height=0
                      column padding="0 20px 16px"
                        gap=12
                        max-width="26.25rem"
                        margin-left="auto"
                        margin-right="auto"
                        box-sizing="border-box"
                        width="100%"
                        column gap=6
                          Label(
                            label=(k.cadence == "weekly" ? `${cadenceLabel(k.cadence)} · ${t("task_detail.weekly_progress", done=`${k.weeklyDone}`, target=`${k.weeklyTarget}`)}` : cadenceLabel(k.cadence))
                          )
                          text k.title class=T1 role="heading" aria-level=1
                        column class=WashBox padding=16 gap=6
                          text t("task_detail.why_this") class=LabelText color="accent.ink"
                          text k.whyThis class=Body color="ink.main" testId="task-why"
                        column class=CardBox padding=16 gap=8
                          row align-items="center"
                            justify-content="space-between"
                            gap=8
                            flex-wrap="wrap"
                            Label(label=t("task_detail.how"))
                            Chip(label=evidenceLabel(k.evidence))
                          text k.body class=Body
                        row gap=10 flex-wrap="wrap"
                          column class=RaisedBox flex="1 1 8rem" padding="12px 14px" gap=4
                            Label(label=t("task_detail.expect"))
                            text t("task_detail.how_long", low=`${k.weeksLow}`, high=`${k.weeksHigh}`) class=T3
                          column class=RaisedBox flex="1 1 8rem" padding="12px 14px" gap=4
                            Label(label=t("task_detail.effort"))
                            text effortLabel(k.effort) class=T3
                    column padding="12px 20px 26px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      if k.done
                        Secondary(
                          label=t("task_detail.mark_undone"),
                          go=setTask(k.id, false),
                          id="task-toggle"
                        )
                      else
                        Primary(
                          label=t("task_detail.mark_done"),
                          go=setTask(k.id, true),
                          off=false,
                          id="task-toggle"
                        )
              else if e.name == "done"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  scroll flex=1 min-height=0
                    column align-items="center"
                      padding="56px 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      view position="relative" width=200 height=200
                        svg viewBox="0 0 200 200"
                          position="absolute"
                          inset=0
                          width="100%"
                          height="100%"
                          aria-hidden=true
                          for a in [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330] key=a
                            line x1=100
                              y1=4
                              x2=100
                              y2=18
                              stroke="positive.fill"
                              stroke-width=3
                              stroke-linecap="round"
                              opacity=0.45
                              transform=`rotate(${a} 100 100)`
                          circle cx=100
                            cy=100
                            r=66
                            fill="positive.wash"
                            stroke="positive.fill"
                            stroke-width=9
                        column position="absolute"
                          inset=0
                          align-items="center"
                          justify-content="center"
                          svg width=56 height=56 viewBox="0 0 30 30" aria-hidden=true
                            path d="M7 15.5l5.2 5.2L23 10"
                              stroke="positive.fill"
                              stroke-width=3
                              fill="none"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                      text t("day_done.title", day=`${app.summary.day}`) class=Display
                        role="heading"
                        aria-level=1
                        font-size="3.25rem"
                        line-height=1.3
                        margin-top=24
                        -exact-fit="shrink"

                        testId="done-title"
                      text t("day_done.sub") class=T3 color="ink.soft" margin-top=12
                      row gap=10 margin-top=28 width="100%" flex-wrap="wrap"
                        Tile(
                          value=`${app.summary.currentDays}`,
                          label=t("day_done.streak_label"),
                          tone="flame"
                        )
                        Tile(
                          value=`${app.summary.thisWeekDays}/5`,
                          label=(app.summary.banked.includes(app.summary.week) ? t("day_done.banked_label", week=`${app.summary.week}`) : t("day_done.week_label", week=`${app.summary.week}`)),
                          tone="positive"
                        )
                      text t("day_done.note") class=Caption text-align="center" margin-top=24
                  column padding="12px 20px 26px"
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    Primary(label=t("common.done"), go=goHome, off=false, id="done-ok")
              else if e.name == "plan"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(
                    title=t("plan.title"),
                    trailing="",
                    close=false,
                    back=back,
                    backLabel=t("common.back")
                  )
                  scroll flex=1 min-height=0 testId="plan-list"
                    column padding="0 20px 24px"
                      gap=10
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text (app.plan.length == 1 ? t("plan.count_one") : t("plan.count", n=`${app.plan.length}`)) class=Display
                        role="heading"
                        aria-level=1
                        font-size="2.5rem"
                        line-height=1.3
                        margin-top=6
                      text t("plan.intro") class=Body margin-bottom=8
                      for c in app.plan key=c.ruleId
                        link href=path("card", c.ruleId)
                          class=LipBox
                          testId=`card-${c.ruleId}`
                          display="flex"
                          align-items="center"
                          gap=12
                          padding="14px 16px"
                          column flex=1 min-width=0 gap=1
                            text c.headline class=RowTitle
                            text evidenceLabel(c.evidence) class=Detail
                          Chevron()
                      if app.info.length > 0
                        view margin-top=12
                          Label(label=t("plan.section_info"))
                        for c in app.info key=c.ruleId
                          link href=path("card", c.ruleId)
                            class=LipBox
                            testId=`card-${c.ruleId}`
                            display="flex"
                            align-items="center"
                            gap=12
                            padding="14px 16px"
                            text c.headline class=RowTitle flex=1 min-width=0
                            Chevron()
                      for c in app.professional key=c.ruleId
                        column border="1.5px dashed"
                          border-color="ink.faint"
                          border-radius=16
                          padding=16
                          gap=6
                          margin-top=12
                          testId=`pro-${c.ruleId}`
                          Label(label=t("plan.section_professional"))
                          text c.headline class=RowTitle
                          text c.body class=Detail color="ink.soft"
              else if e.name == "card"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(title="", trailing="", close=false, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0
                    for c in app.plan.concat(app.info).filter(x => x.ruleId == e.params.id) key=c.ruleId
                      column padding="0 20px 24px"
                        gap=12
                        max-width="26.25rem"
                        margin-left="auto"
                        margin-right="auto"
                        box-sizing="border-box"
                        width="100%"
                        text c.headline class=T1 role="heading" aria-level=1
                        column class=WashBox padding=16 gap=6
                          text t("task_detail.why_this") class=LabelText color="accent.ink"
                          text c.whyThis class=Body color="ink.main"
                        column class=CardBox padding=16 gap=8
                          row align-items="center"
                            justify-content="space-between"
                            gap=8
                            flex-wrap="wrap"
                            Label(label=t("task_detail.how"))
                            Chip(label=evidenceLabel(c.evidence))
                          text c.body class=Body testId="card-body"
                        row gap=10 flex-wrap="wrap"
                          column class=RaisedBox flex="1 1 8rem" padding="12px 14px" gap=4
                            Label(label=t("task_detail.expect"))
                            text t("task_detail.how_long", low=`${c.weeksLow}`, high=`${c.weeksHigh}`) class=T3
                          column class=RaisedBox flex="1 1 8rem" padding="12px 14px" gap=4
                            Label(label=t("task_detail.effort"))
                            text effortLabel(c.effort) class=T3
              else if e.name == "paywall"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  navigationPresentation="modal"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(title="", trailing="", close=true, back=back, backLabel=t("common.close"))
                  scroll flex=1 min-height=0
                    column padding="0 20px 16px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("paywall.title", n=`${app.nMetrics}`) class=Display
                        role="heading"
                        aria-level=1
                        font-size="min(-exact-large-title, 44px)"
                        line-height=1.3
                      text (app.lockedMore > 0 ? t("paywall.intro", names=app.lockedNames, more=`${app.lockedMore}`) : t("paywall.intro_plain")) class=Body
                        margin-top=10
                        testId="paywall-intro"
                      column class=CardBox overflow="hidden" margin-top=18
                        row background-color="bg.raised" padding="10px 16px" gap=8
                          view flex=1
                          text t("paywall.col_free") class=LabelText
                            width="3rem"
                            text-align="center"
                          text t("paywall.col_pro") class=LabelText
                            color="ink.main"
                            width="3rem"
                            text-align="center"
                        for i in [1, 2, 3, 4] key=i
                          row align-items="center"
                            padding="12px 16px"
                            gap=8
                            border-top="1.5px solid"
                            border-color="line.hair"
                            text (i == 1 ? t("paywall.row_1") : i == 2 ? t("paywall.row_2") : i == 3 ? t("paywall.row_3", n=`${app.nMetrics}`) : t("paywall.row_4")) font-size="0.875rem"
                              line-height="1.25rem"
                              color="ink.main"
                              flex=1
                              min-width=0
                            row width="3rem" justify-content="center"
                              if i <= 2
                                svg width=12 height=12 viewBox="0 0 12 12" aria-hidden=true
                                  path d="M2 6.5l2.6 2.6L10 3.6"
                                    stroke="positive.text"
                                    stroke-width=1.8
                                    fill="none"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                              else
                                view width=10 height=2 border-radius=1 background-color="ink.faint"
                            row width="3rem" justify-content="center"
                              svg width=12 height=12 viewBox="0 0 12 12" aria-hidden=true
                                path d="M2 6.5l2.6 2.6L10 3.6"
                                  stroke="positive.text"
                                  stroke-width=1.8
                                  fill="none"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                      column gap=10 margin-top=16 role="radiogroup"
                        PlanOption(
                          name=t("paywall.plan_annual"),
                          tag=(saving > 0 ? t("paywall.save_tag", pct=formatNumber(saving, "percent")) : ""),
                          sub=(inDollars and yearPrice > 0 ? t("paywall.week_equivalent", price=formatNumber(yearPrice / 52, "currency", "USD")) : ""),
                          price=priceOf(plans, "pro.annual"),
                          per=t("paywall.per_year"),
                          on=(plan == "pro.annual"),
                          go=choosePlan("pro.annual"),
                          id="plan-pro.annual"
                        )
                        PlanOption(
                          name=t("paywall.plan_weekly"),
                          tag="",
                          sub="",
                          price=priceOf(plans, "pro.weekly"),
                          per=t("paywall.per_week"),
                          on=(plan == "pro.weekly"),
                          go=choosePlan("pro.weekly"),
                          id="plan-pro.weekly"
                        )
                      text t("paywall.renewal_terms") class=Caption margin-top=14
                  column padding="8px 20px 20px"
                    gap=4
                    max-width="26.25rem"
                    margin-left="auto"
                    margin-right="auto"
                    box-sizing="border-box"
                    width="100%"
                    if buyNote != "" or buyError != ""
                      text (buyError != "" and not pending(bought) ? buyError : buyNote) class=Detail
                        text-align="center"
                        testId="buy-note"
                    Primary(label=t("paywall.cta"), go=buy, off=pending(bought), id="buy")
                    Quiet(label=t("paywall.keep_free"), go=back, id="keep-free")
                    if store.available
                      Quiet(label=t("common.restore_purchases"), go=restore, id="restore")
              else if e.name == "path"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  box-sizing="border-box"
                  padding-bottom="calc(60px + env(safe-area-inset-bottom))"
                  scroll flex=1 min-height=0 testId="path-list"
                    column padding="0 20px 24px"
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      row align-items="center" justify-content="space-between" min-height=56
                        text t("journey.title") class=T3
                        StreakPill(count=app.summary.currentDays)
                      text t("journey.week_of", week=`${app.summary.week > 8 ? 8 : app.summary.week}`) class=Display
                        role="heading"
                        aria-level=1
                        font-size="2.5rem"
                        line-height=1.3
                        margin-top=2
                        testId="path-week"
                      text t("journey.intro") class=Body
                        font-size="0.875rem"
                        line-height="1.25rem"
                        margin-top=8
                        testId="path-intro"
                      view position="relative" height=560 margin-top=10
                        svg viewBox="0 0 350 560"
                          preserveAspectRatio="none"
                          position="absolute"
                          inset=0
                          width="100%"
                          height="100%"
                          aria-hidden=true
                          polyline points="70,34 180,98 280,162 180,226 70,290 180,354 280,418 180,490"
                            fill="none"
                            stroke="ink.faint"
                            stroke-width=3
                            stroke-linecap="round"
                            stroke-dasharray="2 9"
                          polyline points=[1, 2, 3, 4, 5, 6, 7, 8].filter(w => w <= app.summary.week).map(w => `${nodeX(w)},${nodeY(w)}`).join(" ")
                            fill="none"
                            stroke="positive.fill"
                            stroke-width=3
                            stroke-linecap="round"
                        for w in [1, 2, 3, 4, 5, 6, 7, 8] key=w
                          row position="absolute"
                            left=`calc(${nodeX(w) / 3.5}% - 28px)`
                            top=(nodeY(w) - 28)
                            width=56
                            height=56
                            border-radius=999
                            box-sizing="border-box"
                            align-items="center"
                            justify-content="center"
                            testId=`week-${w}`
                            background-color=(app.summary.banked.includes(w) ? "positive.fill" : w == app.summary.week ? "accent.main" : w == 4 or w == 8 ? "bg.card" : "bg.track")
                            border=(app.summary.banked.includes(w) or w == app.summary.week ? "0 solid" : w == 8 ? "2.5px solid" : w == 4 ? "2px dashed" : "0 solid")
                            border-color=(w == 8 ? "finish.gold" : "ink.faint")
                            if app.summary.banked.includes(w)
                              svg width=22 height=22 viewBox="0 0 24 24" aria-hidden=true
                                path d="M6 12.5l4 4L18 8"
                                  stroke="on.accent"
                                  stroke-width=2.6
                                  fill="none"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                            else if w == app.summary.week
                              text `${app.summary.thisWeekDays}/5` font-size="min(-exact-subheadline, 16px)"
                                font-weight=700
                                color="on.accent"
                            else if w == 8
                              svg width=26 height=26 viewBox="0 0 24 24" aria-hidden=true
                                path d="M7 4h10v4.5a5 5 0 01-10 0z"
                                  stroke="finish.gold"
                                  stroke-width=2
                                  fill="none"
                                  stroke-linejoin="round"
                                path d="M7 6H4.5v1.5A3 3 0 007.5 10.5M17 6h2.5v1.5a3 3 0 01-3 3"
                                  stroke="finish.gold"
                                  stroke-width=2
                                  fill="none"
                                  stroke-linejoin="round"
                                path d="M12 13.5V17M9 20h6M10 17h4v3h-4z"
                                  stroke="finish.gold"
                                  stroke-width=2
                                  fill="none"
                                  stroke-linejoin="round"
                            else if w == 4
                              svg width=24 height=24 viewBox="0 0 24 24" aria-hidden=true
                                rect x=3
                                  y=7
                                  width=18
                                  height=13
                                  rx=3
                                  stroke="ink.mute"
                                  stroke-width=2
                                  fill="none"
                                circle cx=12
                                  cy=13.5
                                  r=3.4
                                  stroke="ink.mute"
                                  stroke-width=2
                                  fill="none"
                                path d="M9 7l1.4-2.2h3.2L15 7"
                                  stroke="ink.mute"
                                  stroke-width=2
                                  fill="none"
                                  stroke-linejoin="round"
                            else
                              text `${w}` font-size="min(-exact-footnote, 14px)"
                                font-weight=600
                                color="ink.mute"
                          if w == app.summary.week or w == 4 or w == 8 or app.summary.banked.includes(w)
                            column position="absolute"
                              top=(nodeY(w) - 18)
                              gap=1
                              left=(nodeX(w) > 200 ? "auto" : `calc(${nodeX(w) / 3.5}% + 38px)`)
                              right=(nodeX(w) > 200 ? `calc(${(350 - nodeX(w)) / 3.5}% + 38px)` : "auto")
                              text-align=(nodeX(w) > 200 ? "end" : "start")
                              text (w == app.summary.week ? t("journey.node_current") : t("journey.node_upcoming", week=`${w}`)) font-size="0.8125rem"
                                font-weight=(w == app.summary.week ? 700 : 600)
                                color=(w == app.summary.week ? "accent.main" : "ink.soft")
                              if w == app.summary.week
                                text t("journey.node_current_sub", days=`${app.summary.thisWeekDays}`) font-size="0.75rem"
                                  color="ink.soft"
                              else if w == 4
                                text t("journey.node_scan") font-size="0.75rem" color="ink.mute"
                              else if w == 8
                                text t("journey.node_final") font-size="0.75rem" color="ink.mute"
                              else
                                text t("journey.node_banked") font-size="0.75rem"
                                  color="positive.text"
                      if app.nScans > 1
                        link href=path("progress")
                          testId="open-progress"
                          class=LipBox
                          display="flex"
                          align-items="center"
                          gap=12
                          padding="14px 16px"
                          margin-top=12
                          column flex=1 min-width=0 gap=2
                            text t("journey.progress_row") class=RowTitle
                            text t("progress.scans", n=`${app.nScans}`) class=Detail
                          text app.progress.delta class=Value
                            font-weight=700
                            color=(app.progress.up and not app.progress.withinNoise ? "positive.text" : "ink.main")
                          Chevron()
                      else if app.hasScan
                        text t("progress.empty_body") class=Caption
                          margin-top=12
                          testId="progress-empty"
                      if app.summary.finished
                        column class=RaisedBox padding=16 gap=4 margin-top=12
                          text t("journey.finish_title") class=T3
                          text t("journey.finish_body") class=Body
              else if e.name == "progress"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(
                    title=t("progress.title"),
                    trailing=t("progress.scans", n=`${app.nScans}`),
                    close=false,
                    back=back,
                    backLabel=t("common.back")
                  )
                  scroll flex=1 min-height=0 testId="progress-list"
                    column padding="4px 20px 28px"
                      gap=12
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      column padding=20
                        gap=10
                        border-radius=20
                        background-color=(app.progress.up and not app.progress.withinNoise ? "positive.wash" : "bg.raised")
                        row align-items="center" gap=14 flex-wrap="wrap"
                          text app.progress.delta class=Display
                            font-size="3.5rem"
                            line-height=1.3
                            -exact-fit="shrink"
                            color=(app.progress.up and not app.progress.withinNoise ? "positive.text" : "ink.main")
                            testId="progress-delta"
                          text (app.progress.weeks >= 2 ? t("progress.span_weeks", before=app.progress.before, after=app.progress.after, weeks=`${app.progress.weeks}`) : t("progress.span_days", before=app.progress.before, after=app.progress.after, days=`${app.progress.days}`)) class=Body
                            font-weight=600
                            color="ink.main"
                            flex="1 1 8rem"
                            min-width=0
                        text (not app.progress.comparable ? t("progress.model_note") : app.progress.withinNoise ? t("progress.noise_line") : app.progress.lead != "" ? t("progress.lead", metric=app.progress.lead) : t("progress.noise_line")) class=Detail
                          color="ink.soft"
                          testId="progress-line"
                      view margin-top=6
                        Label(label=t("progress.moved_label"))
                      for r in app.progress.rows key=r.id
                        column class=CardBox padding="14px 16px" gap=8 testId=`progress-row-${r.id}`
                          row align-items="baseline" gap=12
                            text r.short class=RowTitle flex=1 min-width=0
                            if r.locked
                              Lock()
                            else
                              text r.delta class=Value
                                font-weight=700
                                color=(r.withinNoise ? "ink.mute" : r.better ? "positive.text" : "ink.main")
                          view position="relative"
                            height=8
                            border-radius=4
                            background-color="bg.track"
                            if not r.locked
                              view position="absolute"
                                top=0
                                height=8
                                border-radius=4
                                left=`${(r.posA < r.posB ? r.posA : r.posB) * 100}%`
                                width=`${(r.posA < r.posB ? r.posB - r.posA : r.posA - r.posB) * 100 + 3}%`
                                background-color=(r.withinNoise ? "ink.faint" : r.better ? "positive.fill" : "ink.soft")
                          text (r.locked ? (r.withinNoise ? t("progress.delta_within_noise") : r.better ? t("progress.row_better") : t("progress.row_worse")) : `${t("progress.values", before=r.before, after=r.after)} · ${r.withinNoise ? t("progress.delta_within_noise") : r.better ? t("progress.row_better") : t("progress.row_worse")}`) class=Caption
                      text t("progress.bone_note") class=Caption margin-top=8
              else if e.name == "metrics"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  box-sizing="border-box"
                  padding-bottom="calc(60px + env(safe-area-inset-bottom))"
                  row align-items="center"
                    gap=8
                    min-height=56
                    padding="0 20px"
                    border-bottom="1.5px solid"
                    border-color="line.hair"
                    flex-shrink=0
                    flex-wrap="wrap"
                    text app.score font-size="min(-exact-title1, 44px)"
                      font-weight=700
                      letter-spacing="-0.02em"
                      color="ink.main"
                      testId="metrics-score"
                    text t("common.likely_band", low=app.low, high=app.high) font-size="0.8125rem"
                      font-weight=500
                      color="ink.mute"
                      flex="1 1 6rem"
                      testId="results-band"
                    Chip(label=app.tier)
                  scroll flex=1 min-height=0 testId="metrics-list"
                    column padding="20px 20px 24px"
                      gap=10
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      if not isPro
                        column class=WashBox padding=16 gap=12 margin-bottom=18 testId="pro-prompt"
                          column gap=4
                            text t("results.pro_title", n=`${app.nLocked}`) class=T2
                            text t("results.pro_body") class=Detail color="ink.soft"
                          Primary(
                            label=t("results.pro_cta", n=`${app.nMetrics}`),
                            go=visit("/pro"),
                            off=false,
                            id="see-pro"
                          )
                        Label(label=t("results.keep_label"))
                        column class=CardBox overflow="hidden"
                          for m in app.metrics.filter(x => x.id == app.strength or x.id == app.improvable) key=m.id
                            link href=path("metric", m.id)
                              testId=(m.id == app.strength ? "strength" : "improvable")
                              display="flex"
                              align-items="center"
                              gap=12
                              flex-wrap="wrap"
                              padding="14px 16px"
                              border-top=(m.id == app.improvable and app.strength != "" ? "1.5px solid" : "0 solid")
                              border-color="line.hair"
                              column flex="1 1 8rem" min-width=0 gap=1
                                text m.short class=RowTitle
                                text (m.id == app.strength ? t("results.section_strength") : t("results.section_improvable")) class=Detail
                                  color=(m.id == app.strength ? "positive.text" : "accent.main")
                              text m.value class=Value
                        row align-items="baseline" justify-content="space-between" margin-top=14
                          Label(label=t("results.locked_label"))
                          text `${app.nLocked}` class=LabelText
                        column class=CardBox overflow="hidden"
                          for m, i in app.metrics.filter(x => not x.free and x.suppressed == "") key=m.id
                            link href=path("paywall")
                              testId=`metric-${m.id}`
                              display="flex"
                              align-items="center"
                              gap=12
                              padding="13px 16px"
                              border-top=(i == 0 ? "0 solid" : "1.5px solid")
                              border-color="line.hair"
                              text m.short class=RowTitle flex=1 min-width=0
                              view width=40 height=14 border-radius=4 background-color="bg.track"
                              Lock()
                      else
                        for g in ["proportion", "eyes", "midface", "lower", "profile", "appearance"] key=g
                          view margin-top=(g == "proportion" ? 0 : 14)
                            Label(label=groupLabel(g))
                          column class=CardBox overflow="hidden"
                            for m, i in app.metrics.filter(x => x.group == g and x.suppressed == "") key=m.id
                              link href=path("metric", m.id)
                                testId=`metric-${m.id}`
                                display="flex"
                                align-items="center"
                                gap=14
                                padding="12px 16px"
                                border-top=(i == 0 ? "0 solid" : "1.5px solid")
                                border-color="line.hair"
                                column flex=1 min-width=0 gap=6
                                  text m.short class=RowTitle
                                  Track(pos=m.pos)
                                text (m.value == "" ? categoryLabel(m.category) : m.value) class=Value
                      if app.metrics.filter(x => x.suppressed != "").length > 0
                        view margin-top=14
                          Label(label=t("results.not_measured_label"))
                        column class=CardBox overflow="hidden"
                          for m, i in app.metrics.filter(x => x.suppressed != "") key=m.id
                            column padding="12px 16px"
                              gap=1
                              border-top=(i == 0 ? "0 solid" : "1.5px solid")
                              border-color="line.hair"
                              text m.short class=RowTitle
                              text suppressedLabel(m.suppressed) class=Detail color="state.caution"
              else if e.name == "metric"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  for m in app.metrics.filter(x => x.id == e.params.id) key=m.id
                    NavBar(
                      title=m.short,
                      trailing="",
                      close=false,
                      back=back,
                      backLabel=t("common.back")
                    )
                    scroll flex=1 min-height=0
                      column padding="0 20px 24px"
                        gap=12
                        max-width="26.25rem"
                        margin-left="auto"
                        margin-right="auto"
                        box-sizing="border-box"
                        width="100%"
                        row align-items="baseline" gap=10 flex-wrap="wrap"
                          text (m.value == "" ? categoryLabel(m.category) : m.value) font-size="min(-exact-large-title, 56px)"
                            line-height=1.15
                            font-weight=700
                            letter-spacing="-0.02em"
                            color="ink.main"
                            testId="metric-value"
                          if m.value != ""
                            text categoryLabel(m.category) font-size="0.9375rem"
                              font-weight=500
                              color="ink.mute"
                        if m.refLow != ""
                          column class=CardBox padding=16 gap=10
                            row align-items="center"
                              justify-content="space-between"
                              gap=8
                              flex-wrap="wrap"
                              Label(label=t("metric_detail.reference"))
                              Chip(label=evidenceLabel(m.evidence))
                            Track(pos=m.pos)
                            text t("common.typical_range", sex_plural=sexPlural, ref_low=m.refLow, ref_high=m.refHigh) class=Body
                            text reliabilityLabel(m.reliability) class=Detail
                        if m.plain != ""
                          column class=CardBox padding=16 gap=6
                            Label(label=t("metric_detail.measured"))
                            text m.plain class=Body
                        if m.contradicted or m.community
                          column class=WashBox padding=16 gap=6
                            text (m.contradicted ? t("metric_detail.fwhr_explainer") : t("metric_detail.community_explainer")) class=Body
                              color="ink.main"
              else if e.name == "you"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  box-sizing="border-box"
                  padding-bottom="calc(60px + env(safe-area-inset-bottom))"
                  scroll flex=1 min-height=0 testId="content-you"
                    column padding="0 20px 24px"
                      gap=10
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      row align-items="center" min-height=56
                        text t("settings.title") class=T3
                      column class=CardBox overflow="hidden"
                        row align-items="center" gap=12 padding="13px 16px" flex-wrap="wrap"
                          text t("settings.reference_label") class=RowTitle flex="1 1 8rem"
                          text t("settings.reference_table", sex=(sex == "female" ? t("onboarding.about_sex_female") : t("onboarding.about_sex_male")), age_band=ageLabel(ageBand)) class=Detail
                        column padding="13px 16px"
                          gap=1
                          border-top="1.5px solid"
                          border-color="line.hair"
                          text t("settings.goals") class=RowTitle
                          text goals.map(g => goalLabel(g)).join(", ") class=Detail
                        row align-items="center"
                          gap=12
                          padding="13px 16px"
                          border-top="1.5px solid"
                          border-color="line.hair"
                          flex-wrap="wrap"
                          text t("settings.time_budget") class=RowTitle flex="1 1 8rem"
                          text timeLabel(timeBudget) class=Detail
                      if consentedOn != ""
                        view margin-top=14
                          Label(label=t("settings.agreed_label"))
                        column class=CardBox padding="13px 16px" gap=8
                          row align-items="center" gap=12 flex-wrap="wrap"
                            column flex="1 1 10rem" min-width=0 gap=1
                              text t("settings.consent_title") class=RowTitle
                              text t("settings.consent_status", date=consentedOn, version=consentPolicy) class=Detail
                            button appearance="none"
                              press=withdraw
                              testId="withdraw"
                              padding="8px 0 8px 8px"
                              text t("settings.consent_revoke") font-size="0.875rem"
                                font-weight=600
                                color="accent.main"
                          text t("settings.consent_revoke_body") class=Caption
                      column class=CardBox overflow="hidden" margin-top=14
                        link href=path("methodology")
                          testId="open-methodology"
                          display="flex"
                          align-items="center"
                          gap=12
                          padding="14px 16px"
                          text t("settings.methodology") class=RowTitle flex=1 min-width=0
                          Chevron()
                        if store.available
                          button appearance="none"
                            press=restore
                            testId="restore-settings"
                            display="flex"
                            align-items="center"
                            padding="14px 16px"
                            border-top="1.5px solid"
                            border-color="line.hair"
                            text-align="start"
                            text t("common.restore_purchases") class=RowTitle flex=1
                          if isPro
                            link href="https://apps.apple.com/account/subscriptions"
                              testId="manage-subscription"
                              display="flex"
                              align-items="center"
                              gap=12
                              padding="14px 16px"
                              border-top="1.5px solid"
                              border-color="line.hair"
                              text t("settings.manage_subscription") class=RowTitle
                                flex=1
                                min-width=0
                              Chevron()
                      button appearance="none"
                        press=askWipe
                        testId="delete"
                        display="flex"
                        align-items="center"
                        justify-content="center"
                        min-height="3.375rem"
                        margin-top=14
                        border="1.5px solid"
                        border-color="state.critical"
                        border-radius=16
                        background-color="bg.card"
                        text t("settings.delete_everything") font-size="1rem"
                          font-weight=700
                          color="state.critical"
                      text t("settings.delete_body") class=Caption text-align="center"
                      text t("settings.version", app_name="Mog", app_version="0.1.0", model_version="rules-1.1.0") class=Caption
                        text-align="center"
                        margin-top=8
              else if e.name == "methodology"
                column navigationKey=`${e.id}`
                  navigationBar="none"
                  position="absolute"
                  inset=0
                  background-color="bg.paper"
                  NavBar(title="", trailing="", close=false, back=back, backLabel=t("common.back"))
                  scroll flex=1 min-height=0 testId="methodology-list"
                    column padding="0 20px 28px"
                      gap=12
                      max-width="26.25rem"
                      margin-left="auto"
                      margin-right="auto"
                      box-sizing="border-box"
                      width="100%"
                      text t("methodology.title") class=Display
                        role="heading"
                        aria-level=1
                        font-size="2.5rem"
                        line-height=1.3
                      column class=CardBox padding=16 gap=6 testId="how-frames"
                        svg viewBox="0 0 310 96" width="100%" aria-hidden=true
                          line x1=8
                            y1=48
                            x2=302
                            y2=48
                            stroke="ink.faint"
                            stroke-width=1.5
                            stroke-dasharray="4 5"
                          circle cx=20
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameA 3.6s ease-in-out infinite alternate")
                          circle cx=50
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameC 3.6s ease-in-out infinite alternate")
                          circle cx=80
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameB 3.6s ease-in-out infinite alternate")
                          circle cx=110
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameD 3.6s ease-in-out infinite alternate")
                          circle cx=140
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameC 3.6s ease-in-out infinite alternate")
                          circle cx=170
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameA 3.6s ease-in-out infinite alternate")
                          circle cx=200
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameD 3.6s ease-in-out infinite alternate")
                          circle cx=230
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameB 3.6s ease-in-out infinite alternate")
                          circle cx=260
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameC 3.6s ease-in-out infinite alternate")
                          circle cx=290
                            cy=48
                            r=6
                            fill="accent.main"
                            animation=(still ? "none" : "frameB 3.6s ease-in-out infinite alternate")
                        text t("methodology.frames_title") class=RowTitle margin-top=4
                        text t("methodology.frames_body") class=Detail color="ink.soft"
                      column class=CardBox padding=16 gap=6 testId="how-range"
                        svg viewBox="0 0 310 96" width="100%" aria-hidden=true
                          path d="M110 84 L110 39.4 L116 33.7 L122 28.3 L128 23.4 L134 19.1 L140 15.7 L146 13.4 L152 12.2 L158 12.2 L164 13.4 L170 15.7 L176 19.1 L182 23.4 L188 28.3 L194 33.7 L200 39.4 L200 84 Z"
                            fill="accent.wash"
                          path d="M8 83.6 L14 83.3 L20 83.0 L26 82.6 L32 82.0 L38 81.2 L44 80.1 L50 78.7 L56 76.9 L62 74.7 L68 72.0 L74 68.7 L80 64.9 L86 60.6 L92 55.8 L98 50.6 L104 45.1 L110 39.4 L116 33.7 L122 28.3 L128 23.4 L134 19.1 L140 15.7 L146 13.4 L152 12.2 L158 12.2 L164 13.4 L170 15.7 L176 19.1 L182 23.4 L188 28.3 L194 33.7 L200 39.4 L206 45.1 L212 50.6 L218 55.8 L224 60.6 L230 64.9 L236 68.7 L242 72.0 L248 74.7 L254 76.9 L260 78.7 L266 80.1 L272 81.2 L278 82.0 L284 82.6 L290 83.0 L296 83.3 L302 83.6"
                            stroke="ink.mute"
                            stroke-width=2
                            fill="none"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          line x1=8
                            y1=84
                            x2=302
                            y2=84
                            stroke="line.hair"
                            stroke-width=1.5
                          circle cx=182
                            cy=84
                            r=7
                            fill="accent.main"
                            stroke="bg.card"
                            stroke-width=2.5
                            animation=(still ? "none" : "place 1.6s 300ms ease-out both")
                        row gap=14 align-items="center" flex-wrap="wrap"
                          row gap=6 align-items="center"
                            view width=12 height=12 border-radius=3 background-color="accent.wash"
                            text t("methodology.range_legend") class=Caption
                          row gap=6 align-items="center"
                            view width=10 height=10 border-radius=5 background-color="accent.main"
                            text t("methodology.you_legend") class=Caption
                        text t("methodology.range_title") class=RowTitle margin-top=4
                        text t("methodology.range_body") class=Detail color="ink.soft"
                      column class=CardBox padding=16 gap=6 testId="how-band"
                        column gap=6 padding="14px 0 6px"
                          text t("common.likely_band", low=bandLow, high=bandHigh) class=Value
                            font-weight=700
                            text-align="center"
                            testId="how-band-range"
                          view position="relative" height=14
                            view position="absolute"
                              left=0
                              right=0
                              top=4
                              height=6
                              border-radius=3
                              background-color="bg.track"
                            view position="absolute"
                              left=`${bandStart}%`
                              width=`${bandWidth}%`
                              top=0
                              height=14
                              border-radius=7
                              background-color="accent.wash"
                              view width="100%"
                                height=14
                                animation=(still ? "none" : "sweep 2.6s ease-in-out infinite alternate")
                                view width=14
                                  height=14
                                  margin-left=-7
                                  border-radius=7
                                  background-color="accent.main"
                          row justify-content="space-between"
                            text "0" class=Caption
                            text "10" class=Caption
                        text t("methodology.band_title") class=RowTitle margin-top=4
                        text t("methodology.band_body") class=Detail color="ink.soft"
                      view margin-top=6
                        Label(label=t("methodology.section_not"))
                      text t("methodology.what_it_is_not") class=Body
                      text t("reveal.model_version", version=(app.modelVersion == "" ? "rules-1.1.0" : app.modelVersion)) class=Caption
                        margin-top=4
                        testId="how-version"
      row role="tablist"
        appearance="none"
        testId="tabs"
        display=(showTabs ? "flex" : "none")
        position="absolute"
        left=0
        right=0
        bottom=0
        box-sizing="border-box"
        padding="10px 8px calc(8px + env(safe-area-inset-bottom))"
        background-color="bg.paper"
        border-top="1.5px solid"
        border-color="line.hair"
        for t in nav.tabs key=t.name
          button role="tab"
            appearance="none"
            aria-controls=`panel-${t.name}`
            aria-selected=(nav.tab == t.name)
            press=pick(t.name)
            testId=`tab-${t.name}`
            flex=1
            min-width=0
            display="flex"
            flex-direction="column"
            align-items="center"
            gap=4
            color=(nav.tab == t.name ? "accent.main" : "ink.mute")
            svg width=22 height=22 viewBox="0 0 22 22" aria-hidden=true
              if t.name == "today"
                circle cx=11 cy=11 r=8.5 stroke="currentColor" stroke-width=2 fill="none"
                path d="M11 6.5V11l3 2"
                  stroke="currentColor"
                  stroke-width=2
                  fill="none"
                  stroke-linecap="round"
              else if t.name == "path"
                circle cx=6 cy=16.5 r=3 stroke="currentColor" stroke-width=2 fill="none"
                circle cx=16 cy=5.5 r=3 stroke="currentColor" stroke-width=2 fill="none"
                path d="M8.5 14.5L13.5 8"
                  stroke="currentColor"
                  stroke-width=2
                  fill="none"
                  stroke-linecap="round"
              else if t.name == "metrics"
                rect x=3.5
                  y=4.5
                  width=15
                  height=13
                  rx=2.5
                  stroke="currentColor"
                  stroke-width=2
                  fill="none"
                path d="M7 11h8"
                  stroke="currentColor"
                  stroke-width=2
                  fill="none"
                  stroke-linecap="round"
              else
                circle cx=11 cy=8 r=3.5 stroke="currentColor" stroke-width=2 fill="none"
                path d="M4.5 18.5c1-3.5 3.5-5 6.5-5s5.5 1.5 6.5 5"
                  stroke="currentColor"
                  stroke-width=2
                  fill="none"
                  stroke-linecap="round"
            text tabTitle(t.name) font-size="min(-exact-caption2, 11px)"
              line-height=1.3
              font-weight=600
              letter-spacing="0.01em"
      dialog id="wipe" role="alertdialog" aria-label=t("settings.delete_everything")
        text t("settings.delete_body")
        button press=wipe destructive=true commandfor="wipe" command="close" testId="wipe-confirm"
          text t("settings.delete_confirm")
        button commandfor="wipe" command="close"
          text t("common.not_now")
