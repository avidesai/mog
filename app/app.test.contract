test "where there is no store, the paywall lists prices and offers no purchase"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "metric-canthal_tilt_deg"
  clock settle
  expect tree has "keep-free"
  expect tree missing "buy"
  expect tree missing "restore"
  expect state isPro == false
