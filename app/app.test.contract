  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  clock settle
  tap "done-ok"
  clock settle
  clock +172800000
