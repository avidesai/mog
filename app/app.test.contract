test "first session: onboarding, consent, capture, the reveal, then Today"
  expect tree has "start"
  expect state onboarded == false
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect tree has "processing"
  clock +6000
  clock data
  clock settle
  expect state onboarded == true
  expect text "reveal-score" == "5.0"
  expect text "reveal-band" == "likely 3.3–6.7"
  expect text "reveal-tier" == "MTN"
  expect text "reveal-pct" == "· 50th percentile"
  tap "start-week"
  clock settle
  expect state nav.tab == "today"
  expect text "day" == "Day 1"
  expect text "left" == "2 left today."

test "declining consent says what it means and captures nothing"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-female"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "decline"
  expect text "declined" == "Nothing is captured. The app can't measure without this."
  expect state onboarded == false

test "Today survives a relaunch"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  expect tree has "countdown"
  reload
  clock data
  expect state onboarded == true
  expect tree has "today-list"

test "the four tabs: the path, the metrics with the band, and settings"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "tab-path"
  clock settle
  expect text "path-week" == "Week 1 of 8"
  tap "tab-metrics"
  clock settle
  expect text "metrics-score" == "5.0"
  expect text "results-band" == "likely 3.3–6.7"
  expect tree has "strength"
  tap "tab-you"
  clock settle
  expect tree has "open-methodology"

test "delete everything wipes the measurements and returns to the start"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "tab-you"
  clock settle
  tap "delete"
  clock settle
  tap "wipe-confirm"
  clock data
  clock settle
  expect state onboarded == false
  expect state app.hasScan == false
  expect tree has "start"
  reload
  clock data
  expect state onboarded == false
  expect state goals == []
  expect state sex == ""
  expect state ageBand == ""
  expect state adult == false
  expect state adultAt == 0
  expect state timeBudget == 15
  expect state region == ""
  expect state consentedOn == ""
  expect state consentedAt == 0
  expect state consentPolicy == ""
  expect state streakSeenOn == ""
  expect state app.hasScan == false

test "Illinois, Texas or Washington: the consent screen says so and offers no consent"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-restricted"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  expect tree has "state-block"
  expect tree missing "consent"
  expect state consentedOn == ""

test "withdrawing consent keeps the measurements and asks again before the next scan"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect state consentPolicy == "1.0"
  expect state consentedAt >= 1
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "tab-you"
  clock settle
  tap "withdraw"
  expect state consentedOn == ""
  expect state app.hasScan == true

test "a task opens its detail, says why, and toggles done"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "open-task_spf_daily"
  clock settle
  expect tree has "task-why"
  expect text "task-toggle" == "Done for today"
  tap "task-toggle"
  clock data
  expect text "task-toggle" == "Undo"
  expect state app.tasks.0 .done == true

test "the day's last task marks the moment, once"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  clock settle
  expect text "done-title" == "Day 1"
  expect state app.summary.currentDays == 1
  tap "done-ok"
  clock settle
  expect text "left" == "Done for today."
  tap "task-task_spf_daily"
  clock data
  tap "task-task_spf_daily"
  clock data
  clock settle
  expect text "done-title" == "Day 1"

test "a missed day offers the month's repair, which keeps the streak"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "start-week"
  clock settle
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  clock settle
  tap "done-ok"
  clock settle
  clock +172800000
  clock data
  expect tree has "streak-save"
  tap "repair"
  clock data
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  clock settle
  expect state app.summary.currentDays == 2

