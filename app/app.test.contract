test "first session: onboarding, consent, capture, the reveal, then Today"
  expect tree has "start"
  expect state onboarded == false
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect tree has "processing"
  clock +6000
  clock data
  clock settle
  expect state onboarded == true
  expect text "reveal-score" == "5.0"
  expect text "reveal-band" == "likely 3.3 to 6.7"
  expect text "reveal-tier" == "MTN"
  expect text "reveal-pct" == "· 50th percentile"
  tap "start-week"
  clock settle
  expect state nav.tab == "today"
  expect text "day" == "Day 1"
  expect text "left" == "2 left today."

test "declining consent says what it means and captures nothing"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-female"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "decline"
  expect text "declined" == "Nothing is captured. The app can't measure without this."
  expect state onboarded == false
  expect state consentedOn == ""

test "closing the capture while it measures saves nothing, and Not now takes the consent back"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect tree has "processing"
  back
  clock +6000
  clock data
  clock settle
  expect state captured == ""
  expect state app.hasScan == false
  expect state onboarded == false
  expect state consentPolicy == "1.0"
  tap "decline"
  expect state consentedOn == ""
  expect state consentPolicy == ""

