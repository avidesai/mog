test "the paywall: two plans, yearly first, and with no store the button says where purchases work"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-all"
  clock settle
  expect state nav.tab == "metrics"
  tap "metric-canthal_tilt_deg"
  clock settle
  expect text "paywall-intro" == "Canthal tilt, jaw width, midface and 31 more are already measured. Pro shows your number for each one and whether it's in the typical range."
  expect tree has "plan-pro.annual"
  expect tree has "plan-pro.weekly"
  expect tree missing "plan-pro.lifetime"
  expect state plan == "pro.annual"
  tap "plan-pro.weekly"
  expect state plan == "pro.weekly"
  tap "buy"
  expect text "buy-note" == "Purchases work in the iPhone app."
  expect tree missing "restore"
  expect state isPro == false

