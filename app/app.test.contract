test "first session: onboarding, consent, capture, reveal, results, plan"
  expect tree has "start"
  expect state onboarded == false
  tap "start"
  clock settle
  expect disabled "goals-next"
  tap "goal-better_skin"
  tap "goal-sharper_jawline"
  expect state goals.0 == "better_skin"
  expect state goals.1 == "sharper_jawline"
  tap "goals-next"
  clock settle
  expect disabled "about-next"
  tap "sex-male"
  tap "age-25-34"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-15"
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect tree has "processing"
  clock +6000
  clock data
  clock settle
  expect state onboarded == true
  expect text "reveal-band" == "likely 3.3–6.7"
  expect text "reveal-tier" == "Mid-tier normie · roughly the 50th percentile of the reference distribution"
  tap "see-results"
  clock settle
  expect tree has "strength"
  expect tree has "improvable"
  tap "see-plan"
  clock settle
  expect state nav.tab == "plan"
  expect tree has "plan-list"

test "declining consent says what it means and captures nothing"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-female"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "decline"
  expect text "declined" == "Without this, the app can't measure anything. Nothing is captured."
  expect state onboarded == false

test "a day's tasks count toward the streak and survive a relaunch"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "see-plan"
  clock settle
  tap "tab-today"
  clock settle
  expect tree has "today-list"
  expect tree has "countdown"
  reload
  clock data
  expect state onboarded == true
  expect tree has "today-list"

test "delete everything wipes the measurements and returns to the start"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "see-plan"
  clock settle
  tap "tab-you"
  clock settle
  tap "delete"
  clock settle
  tap "wipe-confirm"
  clock data
  clock settle
  expect state onboarded == false
  expect state app.hasScan == false
  expect tree has "start"
  reload
  clock data
  expect state onboarded == false
  expect state goals == []
  expect state sex == ""
  expect state ageBand == ""
  expect state adult == false
  expect state adultAt == 0
  expect state timeBudget == 15
  expect state region == ""
  expect state consentedOn == ""
  expect state consentedAt == 0
  expect state consentPolicy == ""
  expect state app.hasScan == false

test "Illinois, Texas or Washington: the consent screen says so and offers no consent"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-restricted"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  expect tree has "state-block"
  expect tree missing "consent"
  expect state consentedOn == ""

test "withdrawing consent keeps the measurements and asks again before the next scan"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  expect state consentPolicy == "1.0"
  expect state consentedAt >= 1
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "see-plan"
  clock settle
  tap "tab-you"
  clock settle
  tap "withdraw"
  expect state consentedOn == ""
  expect state app.hasScan == true

test "a task opens its detail, says why, and toggles done"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "see-plan"
  clock settle
  tap "tab-today"
  clock settle
  tap "open-task_spf_daily"
  clock settle
  expect tree has "task-why"
  expect text "task-toggle" == "Done for today"
  tap "task-toggle"
  clock data
  expect text "task-toggle" == "Undo"
  expect state app.tasks.0 .done == true

test "a missed day offers the month's repair, which keeps the streak"
  tap "start"
  clock settle
  tap "goal-general"
  tap "goals-next"
  clock settle
  tap "sex-male"
  tap "age-18-24"
  tap "region-other"
  tap "adult"
  tap "about-next"
  clock settle
  tap "time-next"
  clock settle
  tap "consent"
  clock settle
  clock +6000
  clock data
  clock settle
  tap "see-results"
  clock settle
  tap "see-plan"
  clock settle
  tap "tab-today"
  clock settle
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  expect state app.summary.currentDays == 1
  clock +172800000
  clock data
  expect tree has "streak-save"
  tap "repair"
  clock data
  tap "task-task_spf_daily"
  clock data
  tap "task-task_sleep_regular"
  clock data
  expect state app.summary.currentDays == 2

